# Flutter / Dart
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.packages
build/
coverage/

# Generated code — regenerated in CI via
# `dart run build_runner build --delete-conflicting-outputs`
*.g.dart
*.drift.dart
*.freezed.dart

# Platform trees are scaffolded in CI (flutter create) and contain
# machine-specific paths (SDK locations, local.properties, ephemeral
# build files) — never commit them.
# (e.g. ios/Flutter/ephemeral/flutter_native_integration.env)
/android/
/ios/
/windows/
pubspec.lock

# Signing secrets (never commit — see docs/release.md)
*.jks
*.keystore
*.p12
*.mobileprovision
android/key.properties
android/app/upload-keystore.jks
android/app/debug.keystore
secrets/

# Logs
*.log
logs/

# OS
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/
*.swp
*.tmp

# Temp
tmp/
temp/

